<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - A246F IQC Monitoring</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/iqc.css" asp-append-version="true" />
</head>

<body>

    <!-- TOP HEADER -->
    <header class="top-header">

        <div class="application-title">
            <div class="application-icon">
                <i class="bi bi-clipboard2-data-fill"></i>
            </div>

            <span>A246F IQC Monitoring</span>
        </div>

        <div class="header-right">

            <div class="date-time">
                <i class="bi bi-calendar3"></i>
                <span id="currentDateTime"></span>
            </div>

            <div class="header-divider"></div>

            <div class="user-info">
                <div class="user-icon">
                    <i class="bi bi-person-fill"></i>
                </div>

                <span>Admin</span>

                <i class="bi bi-chevron-down"></i>
            </div>

        </div>

    </header>


    <!-- SIDEBAR -->
    <aside class="sidebar">

        <div class="sidebar-menu">

            <a asp-controller="TemplateData"
               asp-action="Index"
               class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "TemplateData" ? "active" : "")">

                <i class="bi bi-layers-fill"></i>
                <span>Template Data</span>

            </a>

            <a asp-controller="IQCData"
               asp-action="Index"
               class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "IQCData" ? "active" : "")">

                <i class="bi bi-bar-chart-fill"></i>
                <span>IQC - Data</span>

            </a>

        </div>

        <div class="sidebar-decoration"></div>

    </aside>


    <!-- MAIN CONTENT -->
    <main class="main-content">

        @RenderBody()

    </main>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>